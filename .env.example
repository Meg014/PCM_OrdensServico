# Copie para config/.env (único arquivo carregado por CLI e web).
# Valores deste arquivo prevalecem sobre o ambiente dos processos.
# Use aspas simples para caminhos Windows e senhas com espaços ou #.
DEBUG=false
SECURITY_SALT=
APP_FULL_BASE_URL=https://pcm.example.invalid
APP_DEFAULT_TIMEZONE=UTC
APP_DISPLAY_TIMEZONE=America/Sao_Paulo

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pcm
DB_USERNAME=pcm_app
DB_PASSWORD=

# Segunda conexão, exclusivamente SELECT. Preencha em config/.env, nunca no Git.
PROTHEUS_DB_HOST=
PROTHEUS_DB_PORT=1433
PROTHEUS_DB_DATABASE=
PROTHEUS_DB_USERNAME=
PROTHEUS_DB_PASSWORD=
PROTHEUS_DB_ENCRYPT=true
PROTHEUS_DB_TRUST_SERVER_CERTIFICATE=false

PCM_REPORT_PATH='\\servidor\caminho\relatorios'
# Opcionais: sem definição, usam diretórios relativos à raiz do projeto.
# PCM_REPORTS_PROCESSED='D:\dados-pcm\processados'
# PCM_REPORTS_ERROR='D:\dados-pcm\erro'
# PCM_REPORTS_STAGING='D:\dados-pcm\staging'
PCM_OPERATIONAL_REPORT_FILE=
PCM_REPORT_SHEET=sclxd280
PCM_MAX_UPLOAD_BYTES=20971520
PCM_MINIMUM_FILE_AGE_SECONDS=60
PCM_SCHEDULE_INTERVAL_SECONDS=300
# NC e-mail Microsoft 365. Habilitar só após o teste controlado com a TI.
NC_MAIL_ENABLED=false
NC_MAIL_PROFILE=nonconformity
NC_MAIL_PROVIDER=smtp
NC_MAIL_FROM=qualidade@biolasa.com.br
MAIL_HOST=smtp.office365.com
MAIL_PORT=587
MAIL_USER=qualidade@biolasa.com.br
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
# Opcional: limitar o comando de teste a um único endereço aprovado.
NC_MAIL_TEST_RECIPIENT=
